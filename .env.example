# ── Glean MCP ────────────────────────────────────────────────
GLEAN_MCP_URL="https://<company>-be.glean.com/mcp/default"

# ── OAuth ────────────────────────────────────────────────────
# Callback URL — must match the port below.
OAUTH_REDIRECT_URI="http://localhost:3090/oauth/callback"

# Override default scopes if your Glean deployment restricts them.
# GLEAN_OAUTH_SCOPES="SEARCH CHAT MCP DOCUMENTS TOOLS ENTITIES AGENTS"

# ── Server ───────────────────────────────────────────────────
PORT="3090"

# ── Timeouts (ms) ───────────────────────────────────────────
# GLEAN_HTTP_TIMEOUT="180000"
# GLEAN_MCP_TOOL_TIMEOUT="180000"
